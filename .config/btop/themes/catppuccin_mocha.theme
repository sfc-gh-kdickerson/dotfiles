# Catppuccin Mocha palette (https://github.com/catppuccin/palette)
# Official btop mapping is teal→sapphire→lavender on CPU + processes, so the
# big process list reads as one blue smear. Chrome and graphs here stay mocha
# hexes but go cool→warm with load; peach matches the rest of the rice.

# Main background, empty for terminal default
theme[main_bg]=""

# Main text color
theme[main_fg]="#cdd6f4"

# Title color for boxes
theme[title]="#cdd6f4"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#fab387"

# Background color of selected item in processes box
theme[selected_bg]="#45475a"

# Foreground color of selected item in processes box
theme[selected_fg]="#fab387"

# Color of inactive/disabled text
theme[inactive_fg]="#7f849c"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#f5e0dc"

# Background color of the percentage meters
theme[meter_bg]="#45475a"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#f5e0dc"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#cba6f7" #Mauve
theme[mem_box]="#a6e3a1" #Green
theme[net_box]="#eba0ac" #Maroon
theme[proc_box]="#fab387" #Peach

# Box divider line and small boxes line color
theme[div_line]="#6c7086"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#a6e3a1"
theme[temp_mid]="#f9e2af"
theme[temp_end]="#f38ba8"

# CPU graph + process-name colors when proc_colors is on (Green -> Yellow -> Red)
theme[cpu_start]="#a6e3a1"
theme[cpu_mid]="#f9e2af"
theme[cpu_end]="#f38ba8"

# Mem/Disk free meter (Teal -> Blue -> Mauve)
theme[free_start]="#94e2d5"
theme[free_mid]="#89b4fa"
theme[free_end]="#cba6f7"

# Mem/Disk cached meter (Sapphire -> Mauve -> Pink)
theme[cached_start]="#74c7ec"
theme[cached_mid]="#cba6f7"
theme[cached_end]="#f5c2e7"

# Mem/Disk available meter (Peach -> Red)
theme[available_start]="#fab387"
theme[available_mid]="#eba0ac"
theme[available_end]="#f38ba8"

# Mem/Disk used meter (Green -> Yellow -> Peach)
theme[used_start]="#a6e3a1"
theme[used_mid]="#f9e2af"
theme[used_end]="#fab387"

# Download graph colors (Peach -> Red)
theme[download_start]="#fab387"
theme[download_mid]="#eba0ac"
theme[download_end]="#f38ba8"

# Upload graph colors (Green -> Sky)
theme[upload_start]="#a6e3a1"
theme[upload_mid]="#94e2d5"
theme[upload_end]="#89dceb"

# Process box color gradient for threads, mem and cpu usage (Teal -> Peach -> Red)
theme[process_start]="#94e2d5"
theme[process_mid]="#fab387"
theme[process_end]="#f38ba8"
