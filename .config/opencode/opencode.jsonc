{
  "$schema": "https://opencode.ai/config.json",
  // Snowflake AI Gateway (SNOWFLAKE) on snowhouse. Model IDs match
  // voltron-config/configs/prod/models. OpenCode 2.0 schema: providers/settings/agents.
  // Claude goes through /v1/messages; everything else through /v1/chat/completions.
  "model": "snowflake-cortex/glm-5.3",
  "default_agent": "light",
  "plugins": [
    "-opencode.models-dev",
    "-opencode.provider.*",
    "opencode.provider.snowflake-cortex"
  ],
  "providers": {
    "snowflake-anthropic": {
      "name": "Snowflake AI Gateway (Anthropic)",
      "env": ["SNOWHOUSE_OAUTH_TOKEN"],
      "package": "@opencode-ai/ai/providers/anthropic-compatible",
      "settings": {
        "baseURL": "https://snowhouse.snowflakecomputing.com/api/v2/aigateways/SNOWFLAKE",
        "apiKey": "{env:SNOWHOUSE_OAUTH_TOKEN}"
      },
      "headers": {
        "snow-agent-name": "opencode",
        "X-SNOWFLAKE-APPLICATION": "sf-ai-opencode"
      },
      "models": {
        "claude-fable-5": { "name": "Claude Fable 5" },
        "claude-fable-5-1": { "name": "Claude Fable 5.1" },
        "claude-haiku-4-5": { "name": "Claude Haiku 4.5" },
        "claude-opus-4-5": { "name": "Claude Opus 4.5" },
        "claude-opus-4-6": { "name": "Claude Opus 4.6" },
        "claude-opus-4-7": { "name": "Claude Opus 4.7" },
        "claude-opus-4-8": { "name": "Claude Opus 4.8" },
        "claude-opus-5": { "name": "Claude Opus 5" },
        "claude-sonnet-4-5": { "name": "Claude Sonnet 4.5" },
        "claude-sonnet-4-6": { "name": "Claude Sonnet 4.6" },
        "claude-sonnet-5": { "name": "Claude Sonnet 5" }
      }
    },
    "snowflake-cortex": {
      "name": "Snowflake AI Gateway (OpenAI)",
      "env": ["SNOWHOUSE_OAUTH_TOKEN"],
      "package": "@opencode-ai/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://snowhouse.snowflakecomputing.com/api/v2/aigateways/SNOWFLAKE/v1",
        "apiKey": "{env:SNOWHOUSE_OAUTH_TOKEN}"
      },
      "headers": {
        "snow-agent-name": "opencode",
        "X-SNOWFLAKE-APPLICATION": "sf-ai-opencode"
      },
      "models": {
        // Gateway lists Claude on the OpenAI-compat /v1/models catalog too.
        // Those IDs 503 on /chat/completions — use snowflake-anthropic instead.
        "claude-fable-5": { "disabled": true },
        "claude-haiku-4-5": { "disabled": true },
        "claude-opus-4-5": { "disabled": true },
        "claude-opus-4-6": { "disabled": true },
        "claude-opus-4-7": { "disabled": true },
        "claude-opus-4-7-fast": { "disabled": true },
        "claude-opus-4-8": { "disabled": true },
        "claude-opus-5": { "disabled": true },
        "claude-sonnet-4-5": { "disabled": true },
        "claude-sonnet-4-6": { "disabled": true },
        "claude-sonnet-5": { "disabled": true },
        "cygnal-qwen3-8b-032026": { "name": "Cygnal Qwen3 8B" },
        "deepseek-v4-flash": { "name": "DeepSeek V4 Flash" },
        "gemma-4-26b-a4b": { "name": "Gemma 4 26B A4B" },
        "gemma-4-31b": { "name": "Gemma 4 31B" },
        "gemma-4-e2b": { "name": "Gemma 4 E2B" },
        "glm-5.2": { "name": "GLM 5.2" },
        "glm-5.2-exp": { "name": "GLM 5.2 Exp" },
        "glm-5.3": { "name": "GLM 5.3" },
        "grok-4.6": { "name": "Grok 4.6" },
        "ministral-3-8b": { "name": "Ministral 3 8B" },
        "openai-gpt-5": {
          "name": "GPT-5",
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
          ]
        },
        "openai-gpt-5-mini": {
          "name": "GPT-5 Mini",
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
          ]
        },
        "openai-gpt-5-nano": {
          "name": "GPT-5 Nano",
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
          ]
        },
        "openai-gpt-5.1": {
          "name": "GPT-5.1",
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
          ]
        },
        "openai-gpt-5.2": {
          "name": "GPT-5.2",
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
          ]
        },
        "openai-gpt-5.4": {
          "name": "GPT-5.4",
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
          ]
        },
        "openai-gpt-5.4-mini": {
          "name": "GPT-5.4 Mini",
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
          ]
        },
        "openai-gpt-5.4-nano": {
          "name": "GPT-5.4 Nano",
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
          ]
        },
        "openai-gpt-5.5": {
          "name": "GPT-5.5",
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
          ]
        },
        "openai-gpt-5.6-luna": {
          "name": "GPT-5.6 Luna",
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
          ]
        },
        "openai-gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
          ]
        },
        "openai-gpt-5.6-terra": {
          "name": "GPT-5.6 Terra",
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
          ]
        }
      }
    }
  },
  "agents": {
    "build": {
      "model": "snowflake-cortex/openai-gpt-5.6-terra#high"
    },
    "plan": {
      "model": "snowflake-anthropic/claude-opus-5"
    },
    "compaction": {
      "model": "snowflake-cortex/openai-gpt-5.6-terra#low"
    },
    "explore": {
      "model": "snowflake-cortex/openai-gpt-5.6-luna#low"
    },
    "summary": {
      "model": "snowflake-cortex/openai-gpt-5.6-luna#low"
    },
    "title": {
      "model": "snowflake-cortex/openai-gpt-5.6-luna#low"
    },
    "light": {
      "mode": "primary",
      "description": "Lightweight general-purpose agent for routine tasks.",
      "model": "snowflake-cortex/glm-5.3"
    }
  },
  "mcp": {
    // Same user-level set as ~/.cursor/mcp.json (sf-cli stdio wrappers).
    "timeout": { "startup": 60000 },
    "servers": {
      "glean": {
        "type": "local",
        "command": ["/opt/sf-cli/dist/sf", "mcp", "run", "glean"]
      },
      "jenkins": {
        "type": "local",
        "command": ["/opt/sf-cli/dist/sf", "mcp", "run", "jenkins"]
      },
      "natoma_atlassian_remote": {
        "type": "local",
        "command": ["/opt/sf-cli/dist/sf", "mcp", "natoma", "run", "atlassian-remote"]
      },
      "natoma_google_calendar": {
        "type": "local",
        "command": ["/opt/sf-cli/dist/sf", "mcp", "natoma", "run", "google-calendar"]
      },
      "natoma_google_drive": {
        "type": "local",
        "command": ["/opt/sf-cli/dist/sf", "mcp", "natoma", "run", "google-drive"]
      },
      "natoma_google_gmail": {
        "type": "local",
        "command": ["/opt/sf-cli/dist/sf", "mcp", "natoma", "run", "google-gmail"]
      },
      "natoma_slack_remote": {
        "type": "local",
        "command": ["/opt/sf-cli/dist/sf", "mcp", "natoma", "run", "slack-remote"]
      },
      "snowci": {
        "type": "local",
        "command": ["/opt/sf-cli/dist/sf", "mcp", "run", "snowci"]
      },
      "snowhouse": {
        "type": "local",
        "command": ["/opt/sf-cli/dist/sf", "mcp", "run", "snowhouse"]
      },
      "snowtrail": {
        "type": "local",
        "command": ["/opt/sf-cli/dist/sf", "mcp", "run", "snowtrail"]
      }
    }
  }
}
