{
  "$schema": "https://opencode.ai/config.json",
  // Snowflake AI Gateway (SNOWFLAKE) on snowhouse.
  // DESCRIBE AI GATEWAY SNOWFLAKE is models: [{name: '*'}] — this map is the
  // known-working set, not the public Cortex AI_COMPLETE table (those IDs 400).
  // Claude goes through /v1/messages; everything else through /v1/chat/completions.
  "model": "snowflake-cortex/grok-4.6",
  "small_model": "snowflake-cortex/openai-gpt-5.6-luna#none",
  "default_agent": "build",
  "enabled_providers": ["snowflake-anthropic", "snowflake-cortex"],
  "disabled_providers": ["opencode"],
  "experimental": {
    "policies": [
      { "effect": "deny", "action": "provider.use", "resource": "*" },
      { "effect": "allow", "action": "provider.use", "resource": "snowflake-anthropic" },
      { "effect": "allow", "action": "provider.use", "resource": "snowflake-cortex" }
    ]
  },
  "plugins": [
    "-opencode.models-dev",
    "-opencode.provider.*",
    "opencode.provider.snowflake-cortex"
  ],
  // ~/.cursor/skills is a symlink; OpenCode treats that path as a file.
  // Point at the real directory so SKILL.md files are discovered.
  "skills": ["/home/repo/dotfiles/.cursor/skills"],
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "allow" }
  ],
  "providers": {
    "snowflake-anthropic": {
      "name": "Snowflake AI Gateway (Anthropic)",
      // anthropic-compatible is not in the binary import map; bun then
      // looks up npm @opencode/ai and dies. Native anthropic is bundled.
      // env[] is treated as apiKey → x-api-key, which the gateway 401s.
      "package": "@opencode/ai/providers/anthropic",
      "settings": {
        "baseURL": "https://snowhouse.snowflakecomputing.com/api/v2/aigateways/SNOWFLAKE/v1",
        "authToken": "{env:SNOWHOUSE_OAUTH_TOKEN}"
      },
      "headers": {
        "Authorization": "Bearer {env:SNOWHOUSE_OAUTH_TOKEN}",
        "snow-agent-name": "opencode",
        "X-SNOWFLAKE-APPLICATION": "sf-ai-opencode"
      },
      "models": {
        "claude-fable-5": { "name": "Claude Fable 5" },
        "claude-fable-5-1": { "name": "Claude Fable 5.1" },
        "claude-haiku-4-5": { "name": "Claude Haiku 4.5" },
        "claude-opus-4-5": { "name": "Claude Opus 4.5" },
        "claude-opus-4-6": { "name": "Claude Opus 4.6" },
        "claude-opus-4-7": { "name": "Claude Opus 4.7" },
        "claude-opus-4-8": { "name": "Claude Opus 4.8" },
        "claude-opus-5": { "name": "Claude Opus 5" },
        "claude-sonnet-4-5": { "name": "Claude Sonnet 4.5" },
        "claude-sonnet-4-6": { "name": "Claude Sonnet 4.6" },
        "claude-sonnet-5": { "name": "Claude Sonnet 5" }
      }
    },
    "snowflake-cortex": {
      "name": "Snowflake AI Gateway (OpenAI)",
      "env": ["SNOWHOUSE_OAUTH_TOKEN"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://snowhouse.snowflakecomputing.com/api/v2/aigateways/SNOWFLAKE/v1",
        "apiKey": "{env:SNOWHOUSE_OAUTH_TOKEN}"
      },
      "headers": {
        "snow-agent-name": "opencode",
        "X-SNOWFLAKE-APPLICATION": "sf-ai-opencode"
      },
      "models": {
        // Claude over Chat Completions 503s — use snowflake-anthropic instead.
        "claude-fable-5": { "disabled": true },
        "claude-fable-5-1": { "disabled": true },
        "claude-haiku-4-5": { "disabled": true },
        "claude-opus-4-5": { "disabled": true },
        "claude-opus-4-6": { "disabled": true },
        "claude-opus-4-7": { "disabled": true },
        "claude-opus-4-7-fast": { "disabled": true },
        "claude-opus-4-8": { "disabled": true },
        "claude-opus-5": { "disabled": true },
        "claude-sonnet-4-5": { "disabled": true },
        "claude-sonnet-4-6": { "disabled": true },
        "claude-sonnet-5": { "disabled": true },
        "cygnal-qwen3-8b-032026": { "name": "Cygnal Qwen3 8B" },
        "deepseek-v4-flash": { "name": "DeepSeek V4 Flash" },
        "gemma-4-26b-a4b": { "name": "Gemma 4 26B A4B" },
        "gemma-4-31b": { "name": "Gemma 4 31B" },
        "gemma-4-e2b": { "name": "Gemma 4 E2B" },
        "glm-5.2": { "name": "GLM 5.2" },
        "glm-5.2-exp": { "name": "GLM 5.2 Exp" },
        "glm-5.3": { "name": "GLM 5.3" },
        "grok-4.6": { "name": "Grok 4.6" },
        "ministral-3-8b": { "name": "Ministral 3 8B" },
        "openai-gpt-5": {
          "name": "GPT-5",
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
          ]
        },
        "openai-gpt-5-mini": {
          "name": "GPT-5 Mini",
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
          ]
        },
        "openai-gpt-5-nano": {
          "name": "GPT-5 Nano",
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
          ]
        },
        "openai-gpt-5.1": {
          "name": "GPT-5.1",
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
          ]
        },
        "openai-gpt-5.2": {
          "name": "GPT-5.2",
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
          ]
        },
        "openai-gpt-5.4": {
          "name": "GPT-5.4",
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
          ]
        },
        "openai-gpt-5.4-mini": {
          "name": "GPT-5.4 Mini",
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
          ]
        },
        "openai-gpt-5.4-nano": {
          "name": "GPT-5.4 Nano",
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
          ]
        },
        "openai-gpt-5.5": {
          "name": "GPT-5.5",
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
          ]
        },
        // Gateway: function tools + reasoning_effort ≠ none 400s on luna.
        "openai-gpt-5.6-luna": {
          "name": "GPT-5.6 Luna",
          "reasoning": false,
          "options": { "reasoningEffort": "none" },
          "variants": [
            { "id": "none", "settings": { "reasoningEffort": "none" } }
          ]
        },
        "openai-gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
          ]
        },
        "openai-gpt-5.6-terra": {
          "name": "GPT-5.6 Terra",
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
          ]
        }
      }
    }
  },
  "agents": {
    "build": {
      "model": "snowflake-cortex/grok-4.6",
      "permissions": [
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "allow" }
      ]
    },
    "plan": {
      "model": "snowflake-anthropic/claude-opus-5",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "ask" }
      ]
    },
    "compaction": {
      "model": "snowflake-cortex/openai-gpt-5.6-luna#none"
    },
    "explore": {
      "model": "snowflake-cortex/openai-gpt-5.6-luna#none"
    },
    "summary": {
      "model": "snowflake-cortex/openai-gpt-5.6-luna#none"
    },
    "title": {
      "model": "snowflake-cortex/openai-gpt-5.6-luna#none"
    }
  },
  "mcp": {
    // Same user-level set as ~/.cursor/mcp.json (sf-cli stdio wrappers).
    "timeout": { "startup": 60000 },
    "servers": {
      "glean": {
        "type": "local",
        "command": ["/opt/sf-cli/dist/sf", "mcp", "run", "glean"]
      },
      "jenkins": {
        "type": "local",
        "command": ["/opt/sf-cli/dist/sf", "mcp", "run", "jenkins"]
      },
      "natoma_atlassian_remote": {
        "type": "local",
        "command": ["/opt/sf-cli/dist/sf", "mcp", "natoma", "run", "atlassian-remote"]
      },
      "natoma_google_calendar": {
        "type": "local",
        "command": ["/opt/sf-cli/dist/sf", "mcp", "natoma", "run", "google-calendar"]
      },
      "natoma_google_drive": {
        "type": "local",
        "command": ["/opt/sf-cli/dist/sf", "mcp", "natoma", "run", "google-drive"]
      },
      "natoma_google_gmail": {
        "type": "local",
        "command": ["/opt/sf-cli/dist/sf", "mcp", "natoma", "run", "google-gmail"]
      },
      "natoma_slack_remote": {
        "type": "local",
        "command": ["/opt/sf-cli/dist/sf", "mcp", "natoma", "run", "slack-remote"]
      },
      "snowci": {
        "type": "local",
        "command": ["/opt/sf-cli/dist/sf", "mcp", "run", "snowci"]
      },
      "snowhouse": {
        "type": "local",
        "command": ["/opt/sf-cli/dist/sf", "mcp", "run", "snowhouse"]
      },
      "snowtrail": {
        "type": "local",
        "command": ["/opt/sf-cli/dist/sf", "mcp", "run", "snowtrail"]
      }
    }
  }
}
