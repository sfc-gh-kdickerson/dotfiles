#!/usr/bin/env bash

source "$HOME/.config/sketchybar/variables.sh" # Loads all defined colors

# General bar and defaults
sketchybar --bar height=30 \
	color="$THM_TRANSPARENT" \
	shadow=off \
	border_width=0 \
	position=top \
	sticky=on \
	padding_right=3 \
	padding_left=5 \
	corner_radius="$BAR_CORNER_RADIUS" \
	y_offset=4 \
	margin=7 \
	blur_radius=0 \
	notch_width=200 \
	--default updates=when_shown \
	icon.font="$FONT:Bold:13.5" \
	icon.color="$ICON_COLOR" \
	icon.padding_left="$PADDINGS" \
	icon.padding_right="$PADDINGS" \
	label.font="$FONT:Bold:13.0" \
	label.color="$LABEL_COLOR" \
	label.padding_left="$PADDINGS" \
	label.padding_right="$PADDINGS" \
	background.padding_right="$PADDINGS" \
	background.padding_left="$PADDINGS"

# Left
source "$ITEM_DIR/spaces.sh"
source "$ITEM_DIR/front_app.sh"
source "$ITEM_DIR/ai_spend.sh"
source "$ITEM_DIR/claude_status.sh"

# Right (add order = right-to-left; clock lands at the far right)
source "$ITEM_DIR/clock.sh"
source "$ITEM_DIR/calendar.sh"
source "$ITEM_DIR/events.sh"
source "$ITEM_DIR/volume.sh"
source "$ITEM_DIR/battery.sh"
source "$ITEM_DIR/ram.sh"
source "$ITEM_DIR/cpu.sh"
# source "$ITEM_DIR/vpn.sh"

# Islands (brackets) — added after the items exist
ISLAND_PROPS=(
	background.color="$ISLAND_BG"
	background.corner_radius="$ISLAND_RADIUS"
	background.height="$ISLAND_HEIGHT"
	background.border_width="$ISLAND_BORDER_WIDTH"
	background.border_color="$ISLAND_BORDER_COLOR"
	background.shadow.drawing="$ISLAND_SHADOW"
	background.shadow.color="$ISLAND_SHADOW_COLOR"
	background.shadow.distance="$ISLAND_SHADOW_DISTANCE"
	background.shadow.angle="$ISLAND_SHADOW_ANGLE"
)

sketchybar --add bracket spaces '/space\..*/' --set spaces "${ISLAND_PROPS[@]}"
sketchybar --add bracket ai_spend_island ai_spend.today ai_spend.week --set ai_spend_island "${ISLAND_PROPS[@]}"
sketchybar --add bracket claude_status_island claude_status --set claude_status_island "${ISLAND_PROPS[@]}"
sketchybar --add bracket sysisland cpu ram battery sound --set sysisland "${ISLAND_PROPS[@]}"
sketchybar --add bracket timeisland calevent calendar clock --set timeisland "${ISLAND_PROPS[@]}"

#################### Finalizing Setup ####################

sketchybar --hotload true
sketchybar --update
echo "sketchybar configuration loaded.."
