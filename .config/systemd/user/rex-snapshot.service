[Unit]
Description=Save Rex sessions and restore them after a restart
After=rex.socket
Wants=rex.socket

[Service]
ExecStart=%h/scripts/rex-snapshot watch
StandardOutput=append:%h/.local/state/rex-snapshot/watch.log
StandardError=append:%h/.local/state/rex-snapshot/watch.log
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
