{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "bash ~/.tmux/plugins/tmux-assistant-resurrect/hooks/cursor-session-track.sh"
      }
    ],
    "sessionEnd": [
      {
        "command": "bash ~/.tmux/plugins/tmux-assistant-resurrect/hooks/cursor-session-cleanup.sh"
      }
    ]
  }
}
