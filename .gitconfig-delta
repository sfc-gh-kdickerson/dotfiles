[include]
	path = ~/.config/delta/catppuccin.gitconfig

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	side-by-side = false
	line-numbers = true
	features = catppuccin-mocha
	true-color = always
    side-by-side = false

[merge]
	conflictStyle = zdiff3
