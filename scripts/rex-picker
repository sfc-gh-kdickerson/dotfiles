#!/usr/bin/env bash
# tmux-picker in Rex: the same fzf views and ~/.config/tmux-picker plugins, with
# ~/.config/rex-picker/lua/tmux_picker/tmux.lua answering through the Rex server.
# init.lua opens it in a floating pane (prefix p: projects, prefix e: agents).
#
#   rex-picker [VIEW]    open the picker (projects, agents, sessions, zoxide)
#   rex-picker --resident VIEW
#                        the popup's loop: after each pick or Esc, minimize this
#                        layer and start the next fzf so it is drawn when shown
#   rex-picker doctor    check views and plugins
set -eu

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  dir="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  case "$SOURCE" in /*) ;; *) SOURCE="${dir}/${SOURCE}" ;; esac
done
SELF="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)/$(basename "$SOURCE")"

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/rex-picker"
ROOT="${TMUX_PICKER_ROOT:-$HOME/.tmux/plugins/tmux-picker}"
# Popups start from the Rex server's environment, not a login shell.
PATH="$HOME/scripts:$HOME/.local/bin:$HOME/.nix-profile/bin:$HOME/.npm-global/bin:$HOME/go/bin:/opt/homebrew/bin:/usr/local/bin:${PATH:-/usr/bin:/bin}"
export PATH

fail() {
  printf 'rex-picker: %s\n' "$1" >&2
  if [ "$interactive" = 1 ]; then
    printf 'press any key to close' >&2
    read -rsn1 _ </dev/tty || true
  fi
  exit 1
}

resident=0
if [ "${1:-}" = --resident ]; then
  resident=1
  shift
fi

case "${1:-}" in
  list | current | preview | switch-view | action | execute-action | fzf-enter | fzf-escape | kill | doctor) interactive=0 ;;
  *) interactive=1 ;;
esac

[ -d "$ROOT/lua/tmux_picker" ] || fail "tmux-picker is not installed at $ROOT"
LUA_BIN="$(command -v luajit || command -v lua || true)"
[ -n "$LUA_BIN" ] || fail "luajit or lua not found"
command -v rex >/dev/null || fail "rex not found"

unset TMUX TMUX_PANE
export TMUX_PICKER_ROOT="$ROOT"
export TMUX_PICKER_CMD="$SELF"
export REX_PICKER_STATE="$CONF/state.lua"
export LUA_PATH="$CONF/lua/?.lua;$ROOT/lua/?.lua;$ROOT/lua/?/init.lua;;"

if [ "$interactive" = 0 ]; then
  exec "$LUA_BIN" "$CONF/main.lua" "$@"
fi

# fzf may draw on stderr, so errors print to the popup itself.
if [ "$resident" = 0 ] || [ -z "${REX_BLOCK:-}" ]; then
  "$LUA_BIN" "$CONF/main.lua" "$@" || fail "picker failed"
  exit 0
fi
own_layer() {
  rex --autostart=false api call session.view "{\"session_id\":\"${REX_SESSION:-}\"}" 2>/dev/null |
    jq -r --arg block "$REX_BLOCK" \
      'first(.windows[].layers[]? | select(.kind == "floating" and any(.blocks[]?; .block_id == $block)) | .layer_id) // empty'
}
minimize() {
  [ -n "$1" ] && rex --autostart=false api call session.set_layer_state \
    "{\"session_id\":\"${REX_SESSION:-}\",\"layer_id\":\"$1\",\"state\":\"minimized\"}" >/dev/null 2>&1
}
command -v jq >/dev/null || fail "jq not found"
layer=""
while :; do
  started=$SECONDS
  "$LUA_BIN" "$CONF/main.lua" "$@" || true
  # Out of its floating layer, the picker has no way back, so it closes.
  minimize "$layer" || { layer="$(own_layer)"; minimize "$layer"; } || exit 0
  # A picker that dies on start would otherwise spin.
  [ $((SECONDS - started)) -ge 1 ] || sleep 1
done
