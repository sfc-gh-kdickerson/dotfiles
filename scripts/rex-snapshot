#!/usr/bin/env python3
"""Bring Rex sessions' programs back after the server restarts.

A Rex server saves its sessions when it stops and restores their layouts, with
the same block IDs, when it starts, but the programs that ran in them don't
come back. `watch` saves each session's tabs, split layout, working directories,
and the agent conversation or program in each pane. When it finds a new server
instance, it types `agent --resume <id>` or the program (nvim, lazygit, ...)
into each restored pane that sits at a shell prompt, and rebuilds whole
sessions the server did not restore (a crash or kill before it could save).

`import-tmux` rebuilds a tmux-resurrect save as Rex sessions once, resuming
each Cursor agent pane with the newest conversation from its directory.

`watch` also turns on systemd linger, which the workspace loses on reboot, so
Rex keeps running after the last connection closes.

Usage: rex-snapshot save | watch | linger | restore [--dry-run] [FILE] | show [FILE]
       rex-snapshot import-tmux [--dry-run] [--force] [FILE]
"""

from __future__ import annotations

import argparse
import json
import os
import shlex
import shutil
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

HOME = Path.home()
REX = os.environ.get("REX_CLI") or shutil.which("rex") or str(HOME / ".local/bin/rex")
STATE = Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local/state")
SNAP_DIR = STATE / "rex-snapshot"
LAST = SNAP_DIR / "last.json"
AGENTS = STATE / "rex-agents"
KEEP = 30
INTERVAL = 15

TERMINAL = "com.superlogical.terminal"
SHELL_FLAVOR = "com.superlogical.terminal.shell"
AGENT_PROGRAMS = {"agent", "cursor-agent"}
RESTORE_PROGRAMS = {"nvim", "vim", "vi", "lazygit", "htop", "btop", "top", "k9s", "less", "man", "watch"}
DEFAULT_BLOCK_LABELS = {"", "shell"}


class RexError(Exception):
    pass


def log(message: str) -> None:
    stamp = datetime.now().strftime("%Y-%m-%dT%H:%M:%S")
    print("%s rex-snapshot: %s" % (stamp, message), file=sys.stderr, flush=True)


def rex(*args: str, stdin: str | None = None):
    proc = subprocess.run(
        [REX, "--autostart=false", *args],
        input=stdin,
        capture_output=True,
        text=True,
        timeout=30,
    )
    if proc.returncode != 0:
        raise RexError((proc.stderr or proc.stdout).strip() or "rex %s failed" % " ".join(args))
    out = proc.stdout.strip()
    return json.loads(out) if out else None


def cmdline(pid: int) -> list[str]:
    try:
        raw = Path("/proc/%d/cmdline" % pid).read_bytes()
    except OSError:
        return []
    return [part.decode(errors="replace") for part in raw.split(b"\0") if part]


def pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    return True


def agent_conversation(block_id: str) -> str | None:
    path = AGENTS / ("%s.json" % block_id.split(":", 1)[-1])
    try:
        record = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return None
    pid = record.get("pid")
    if not isinstance(pid, int) or not pid_alive(pid):
        return None
    if not any("agent" in part for part in cmdline(pid)[:3]):
        return None
    return record.get("conversation_id") or None


def describe_block(session_id: str, block: dict) -> dict:
    entry: dict = {}
    label = block.get("label") or ""
    if label not in DEFAULT_BLOCK_LABELS:
        entry["label"] = label
    block_id = block.get("block_id")
    if block_id:
        entry["block_id"] = block_id
    if block.get("creator_name") != TERMINAL:
        return entry
    try:
        info = rex("block", "call", "-s", session_id, "-b", block_id, "process") or {}
    except RexError:
        return entry
    child = info.get("child") or {}
    foreground = info.get("foreground") or {}
    cwd = foreground.get("cwd") or child.get("cwd")
    if cwd:
        entry["cwd"] = cwd
    fg_pid = foreground.get("pid")
    argv = cmdline(fg_pid) if fg_pid else []
    conversation = agent_conversation(block_id) or resumed_conversation(argv)
    if conversation:
        entry["agent"] = conversation
    elif argv and Path(argv[0]).name in RESTORE_PROGRAMS:
        entry["command"] = user_command(argv)
    return entry


def resumed_conversation(argv: list[str]) -> str | None:
    """An agent relaunched with --resume has no hook record until its next prompt."""
    if not argv or Path(argv[0]).name not in AGENT_PROGRAMS or "--resume" not in argv:
        return None
    index = argv.index("--resume") + 1
    return argv[index] if index < len(argv) else None


def user_command(argv: list[str]) -> list[str]:
    """Name the program as typed so PATH finds its wrapper; drop the wrapper's --cmd."""
    name = Path(argv[0]).name
    args = argv[1:]
    if name in {"nvim", "vim", "vi"}:
        kept = []
        skip = False
        for arg in args:
            if skip:
                skip = False
            elif arg == "--cmd":
                skip = True
            else:
                kept.append(arg)
        args = kept
    return [name, *args]


def describe_layout(session_id: str, node: dict, blocks: dict) -> dict:
    split = node.get("split")
    if split:
        return {
            "split": {
                "direction": split["direction"],
                "ratio": split.get("ratio", 0.5),
                "before": describe_layout(session_id, split["before"], blocks),
                "after": describe_layout(session_id, split["after"], blocks),
            }
        }
    block = blocks.get(node.get("block_id"), {"block_id": node.get("block_id")})
    return {"block": describe_block(session_id, block)}


def describe_session(session: dict) -> dict | None:
    view = rex("session", "inspect", session["session_id"], "--json")
    windows = []
    active = 0
    for window in view.get("windows") or []:
        tiled = next((layer for layer in window.get("layers") or [] if layer.get("kind") == "tiled"), None)
        if not tiled or not tiled.get("layout"):
            continue
        blocks = {block["block_id"]: block for block in tiled.get("blocks") or []}
        if window.get("window_id") == view.get("active_window_id"):
            active = len(windows)
        entry = {"layout": describe_layout(view["session_id"], tiled["layout"], blocks)}
        label = window.get("label") or ""
        if label and not label.startswith("Window "):
            entry["label"] = label
        windows.append(entry)
    if not windows:
        return None
    return {
        "session_id": view["session_id"],
        "label": view.get("label") or session.get("label"),
        "active_window": active,
        "windows": windows,
    }


def read_snapshot(path: Path) -> dict | None:
    try:
        return json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return None


def write_json(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps(data, indent=2) + "\n")
    tmp.replace(path)


def prune_agent_records() -> None:
    """Drop records of agents that died without a sessionEnd hook, e.g. a closed pane.

    Covers rex-picker's agent state too: the Cursor hook keys Rex panes by block
    UUID (tmux panes use plain numbers, which are left alone).
    """
    picker_states = (STATE / "tmux-picker-agents").glob("*-*-*-*-*.json")
    for path in [*AGENTS.glob("*.json"), *picker_states]:
        try:
            pid = json.loads(path.read_text()).get("pid")
        except (OSError, json.JSONDecodeError):
            pid = None
        if not isinstance(pid, int) or not pid_alive(pid):
            path.unlink(missing_ok=True)


def save(instance_id: str | None = None) -> dict:
    if instance_id is None:
        instance_id = rex("server", "status", "--json")["instance_id"]
    prune_agent_records()
    sessions = []
    for session in (rex("ls", "--json") or {}).get("sessions") or []:
        try:
            described = describe_session(session)
        except RexError as exc:
            log("skipping %s: %s" % (session.get("label"), exc))
            continue
        if described:
            sessions.append(described)
    previous = read_snapshot(LAST) or {}
    snapshot = {
        "version": 1,
        "saved_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "instance_id": instance_id,
        "sessions": sessions,
    }
    changed = previous.get("sessions") != sessions
    if changed and sessions:
        stamp = datetime.now().strftime("%Y%m%dT%H%M%S")
        write_json(SNAP_DIR / ("snapshot-%s.json" % stamp), snapshot)
        for old in sorted(SNAP_DIR.glob("snapshot-*.json"))[:-KEEP]:
            old.unlink(missing_ok=True)
    if changed or previous.get("instance_id") != instance_id:
        write_json(LAST, snapshot)
    return snapshot


def launch_input(entry: dict) -> str | None:
    if entry.get("agent"):
        return "agent --resume %s" % shlex.quote(entry["agent"])
    if entry.get("command"):
        return " ".join(shlex.quote(part) for part in entry["command"])
    return None


def restore_block(entry: dict) -> dict:
    options: dict = {}
    cwd = entry.get("cwd")
    if cwd and os.path.isdir(cwd):
        options["cwd"] = cwd
    text = launch_input(entry)
    if text:
        options["initial_input"] = text + "\r"
    block: dict = {"flavor": SHELL_FLAVOR}
    if options:
        block["options"] = options
    if entry.get("label"):
        block["label"] = entry["label"]
    return block


def restore_layout(node: dict) -> dict:
    split = node.get("split")
    if split:
        return {
            "split": {
                "direction": split["direction"],
                "ratio": split.get("ratio", 0.5),
                "before": restore_layout(split["before"]),
                "after": restore_layout(split["after"]),
            }
        }
    return {"block": restore_block(node.get("block") or {})}


def panes(node: dict) -> list[dict]:
    split = node.get("split")
    if split:
        return panes(split["before"]) + panes(split["after"])
    return [node.get("block") or {}]


def relaunch(snapshot: dict, dry_run: bool = False) -> int:
    """Rex restores sessions with the same block IDs but not their programs.

    Type each pane's agent or program back into its restored block, if the
    block is sitting at a shell prompt.
    """
    current = {s.get("session_id") for s in (rex("ls", "--json") or {}).get("sessions") or []}
    launched = 0
    for session in snapshot.get("sessions") or []:
        session_id = session.get("session_id")
        if session_id not in current:
            continue
        for window in session.get("windows") or []:
            for entry in panes(window["layout"]):
                block_id = entry.get("block_id")
                text = launch_input(entry)
                if not block_id or not text:
                    continue
                try:
                    info = rex("block", "call", "-s", session_id, "-b", block_id, "process") or {}
                except RexError:
                    continue
                foreground = (info.get("foreground") or {}).get("pid")
                if foreground and foreground != (info.get("child") or {}).get("pid"):
                    continue
                if dry_run:
                    print("%s %s: %s" % (session.get("label"), block_id, text))
                    continue
                try:
                    rex("send", "-s", session_id, "-b", block_id, text)
                    rex("send-key", "-s", session_id, "-b", block_id, "enter")
                except RexError as exc:
                    log("could not relaunch in %s: %s" % (block_id, exc))
                    continue
                launched += 1
                log("relaunched in %s/%s: %s" % (session.get("label"), block_id, text))
    return launched


def restore(snapshot: dict, dry_run: bool = False) -> int:
    listed = (rex("ls", "--json") or {}).get("sessions") or []
    existing = {s.get("label") for s in listed} | {s.get("session_id") for s in listed}
    restored = 0
    for session in snapshot.get("sessions") or []:
        label = session.get("label")
        if label in existing or session.get("session_id") in existing:
            log("session %s already exists; leaving it" % label)
            continue
        windows = []
        for window in session.get("windows") or []:
            item = {"layout": restore_layout(window["layout"])}
            if window.get("label"):
                item["window_label"] = window["label"]
            windows.append(item)
        request = {"label": label, "initial_windows": windows}
        if dry_run:
            print(json.dumps(request, indent=2))
            continue
        try:
            created = rex("api", "call", "session.create", "-", stdin=json.dumps(request))
        except RexError as exc:
            log("could not restore %s: %s" % (label, exc))
            continue
        made = created.get("initial_windows") or []
        active = session.get("active_window", 0)
        if 0 <= active < len(made):
            try:
                rex("api", "call", "-s", created["session_id"], "session.focus_window",
                    json.dumps({"window_id": made[active]["window_id"]}))
            except RexError:
                pass
        restored += 1
        log("restored %s (%d windows)" % (label, len(windows)))
    return restored


TMUX_RESURRECT = HOME / ".tmux/resurrect/last"
CHATS = HOME / ".config/cursor/chats"
IMPORTED = SNAP_DIR / "imported-tmux.json"
SKIP_TMUX_SESSIONS = {"scratch"}


def tmux_layout(node: dict, entries: dict) -> dict:
    """tmux-resurrect's JSON layout tree to a Rex layout of binary splits."""
    if node.get("t") == "p":
        return {"block": entries.get(node.get("i"), {})}
    kids = node.get("c") or []
    if len(kids) == 1:
        return tmux_layout(kids[0], entries)
    horizontal = node.get("t") == "h"
    key = "w" if horizontal else "h"
    total = sum(kid.get(key, 0) for kid in kids) or 1
    rest = kids[1:]
    after = tmux_layout({"t": node.get("t"), "c": rest}, entries) if len(rest) > 1 else tmux_layout(rest[0], entries)
    return {
        "split": {
            "direction": "horizontal" if horizontal else "vertical",
            "ratio": round(min(0.9, max(0.1, kids[0].get(key, 0) / total)), 3),
            "before": tmux_layout(kids[0], entries),
            "after": after,
        }
    }


def chain_layout(entries: list[dict]) -> dict:
    if len(entries) == 1:
        return {"block": entries[0]}
    return {"split": {"direction": "horizontal", "ratio": round(1 / len(entries), 3),
                      "before": {"block": entries[0]}, "after": chain_layout(entries[1:])}}


def conversations_by_cwd(cutoff_ms: int) -> dict[str, list[str]]:
    """Agent CLI conversations that existed at the tmux save, newest first per cwd."""
    found: dict[str, list[tuple[int, str]]] = {}
    for meta in CHATS.glob("*/*/meta.json"):
        try:
            data = json.loads(meta.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        if not data.get("hasConversation") or (data.get("createdAtMs") or 0) > cutoff_ms:
            continue
        found.setdefault(data.get("cwd") or "", []).append((data.get("updatedAtMs") or 0, meta.parent.name))
    return {cwd: [cid for _, cid in sorted(items, reverse=True)] for cwd, items in found.items()}


def tmux_snapshot(path: Path) -> dict:
    """A rex-snapshot from a tmux-resurrect save: tabs, splits, cwds, programs, agents."""
    windows: dict[tuple[str, str], dict] = {}
    pane_rows: dict[tuple[str, str], list[list[str]]] = {}
    order: list[str] = []
    for line in path.read_text().splitlines():
        fields = line.split("\t")
        if fields[0] == "window" and len(fields) >= 7:
            windows[(fields[1], fields[2])] = {"name": fields[3].lstrip(":"), "active": fields[4] == "1",
                                               "layout": fields[6]}
            if fields[1] not in order:
                order.append(fields[1])
        elif fields[0] == "pane" and len(fields) >= 10:
            pane_rows.setdefault((fields[1], fields[2]), []).append(fields)
    conversations = conversations_by_cwd(int(path.stat().st_mtime * 1000))
    sessions = []
    for name in order:
        if name in SKIP_TMUX_SESSIONS:
            continue
        session: dict = {"label": name, "active_window": 0, "windows": []}
        keys = sorted((key for key in windows if key[0] == name), key=lambda key: int(key[1]))
        for key in keys:
            entries: dict = {}
            for fields in pane_rows.get(key, []):
                entry: dict = {}
                cwd = fields[7].lstrip(":")
                if cwd:
                    entry["cwd"] = cwd
                full = fields[10].lstrip(":") if len(fields) > 10 else ""
                if fields[6].startswith("Cursor Agent"):
                    queue = conversations.get(cwd) or []
                    if queue:
                        entry["agent"] = queue.pop(0)
                    else:
                        entry["agent_unknown"] = True
                elif fields[9] in RESTORE_PROGRAMS and full:
                    entry["command"] = shlex.split(full)
                entries[int(fields[5])] = entry
            try:
                layout = tmux_layout(json.loads(windows[key]["layout"])["L"], entries)
            except (json.JSONDecodeError, KeyError, TypeError):
                layout = chain_layout([entries[i] for i in sorted(entries)] or [{}])
            window: dict = {"layout": layout}
            if windows[key]["name"] not in ("", "Window", "zsh", "bash"):
                window["label"] = windows[key]["name"]
            if windows[key]["active"]:
                session["active_window"] = len(session["windows"])
            session["windows"].append(window)
        if session["windows"]:
            sessions.append(session)
    return {"version": 1, "saved_at": datetime.fromtimestamp(path.stat().st_mtime, timezone.utc)
            .isoformat(timespec="seconds"), "source": str(path), "sessions": sessions}


def idle_lone_window(session_id: str) -> str | None:
    """The only window of a session, if it is one pane sitting at a shell prompt."""
    view = rex("session", "inspect", session_id, "--json")
    windows = view.get("windows") or []
    if len(windows) != 1:
        return None
    blocks = [b for layer in windows[0].get("layers") or [] for b in layer.get("blocks") or []]
    if len(blocks) != 1:
        return None
    info = rex("block", "call", "-s", session_id, "-b", blocks[0]["block_id"], "process") or {}
    if (info.get("foreground") or {}).get("pid") != (info.get("child") or {}).get("pid"):
        return None
    return windows[0]["window_id"]


def import_tmux(path: Path, dry_run: bool = False, force: bool = False) -> int:
    source = str(path.resolve())
    done = read_snapshot(IMPORTED) or {}
    if done.get("source") == source and not force:
        print("already imported %s on %s (use --force)" % (source, done.get("imported_at")), file=sys.stderr)
        return 1
    snapshot = tmux_snapshot(path)
    if dry_run:
        summarize(snapshot)
        return 0
    listed = {s["label"]: s["session_id"] for s in (rex("ls", "--json") or {}).get("sessions") or []}
    added = []
    for session in snapshot["sessions"]:
        session_id = listed.get(session["label"])
        if not session_id:
            continue
        # Add the tmux tabs to a session Rex already has; drop its lone idle shell.
        lone = idle_lone_window(session_id)
        made = []
        for window in session["windows"]:
            request = {"session_id": session_id, "layout": restore_layout(window["layout"]), "focus": False}
            if window.get("label"):
                request["window_label"] = window["label"]
            made.append(rex("api", "call", "-s", session_id, "session.new_window", "-", stdin=json.dumps(request)))
        active = session.get("active_window", 0)
        if 0 <= active < len(made):
            rex("api", "call", "-s", session_id, "session.focus_window",
                json.dumps({"window_id": made[active]["window_id"]}))
        if lone:
            rex("api", "call", "-s", session_id, "session.close_window", json.dumps({"window_id": lone}))
        added.append(session["label"])
        log("imported %d tmux tabs into existing session %s" % (len(made), session["label"]))
    restored = restore({"sessions": [s for s in snapshot["sessions"] if s["label"] not in added]})
    write_json(IMPORTED, {"source": source, "imported_at": datetime.now(timezone.utc).isoformat(timespec="seconds")})
    print("imported %d tmux sessions (%d new, %d merged)" % (restored + len(added), restored, len(added)))
    return 0


def loginctl_user(prop: str) -> str:
    try:
        return subprocess.run(["loginctl", "show-user", str(os.getuid()), "-p", prop, "--value"],
                              capture_output=True, text=True, timeout=10).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""


def ensure_linger() -> bool:
    """Keep the user manager, and so Rex and its agents, running with no login session.

    The workspace resets /var/lib on reboot, and logind knows this uid by another
    name than $USER (tpluser), so `loginctl enable-linger $USER` writes a file it
    never reads. Write the file under logind's name.
    """
    if loginctl_user("Linger") == "yes":
        return True
    name = loginctl_user("Name")
    if not name or "/" in name:
        return False
    subprocess.run(["sudo", "-n", "touch", "/var/lib/systemd/linger/" + name], capture_output=True, timeout=10)
    enabled = loginctl_user("Linger") == "yes"
    log("linger for %s: %s" % (name, "enabled" if enabled else "could not enable"))
    return enabled


def watch() -> None:
    log("watching (every %ds, snapshots in %s)" % (INTERVAL, SNAP_DIR))
    ensure_linger()
    while True:
        try:
            status = rex("server", "status", "--json")
            instance = status["instance_id"]
            last = read_snapshot(LAST)
            if last and last.get("sessions") and last.get("instance_id") != instance:
                log("server %s is new; restoring %s" % (instance, last.get("saved_at")))
                relaunched = relaunch(last)
                restore(last)
                if relaunched:
                    # Let the typed commands start so the next save sees them.
                    time.sleep(5)
            save(instance)
        except (RexError, subprocess.TimeoutExpired, KeyError, json.JSONDecodeError) as exc:
            log("cycle failed: %s" % exc)
        time.sleep(INTERVAL)


def summarize(snapshot: dict) -> None:
    print("saved %s (server %s)" % (snapshot.get("saved_at"), snapshot.get("instance_id")))
    for session in snapshot.get("sessions") or []:
        print(session.get("label"))
        for window in session.get("windows") or []:
            print("  %s" % (window.get("label") or "(tab)"))
            for pane in panes(window["layout"]):
                if pane.get("agent_unknown"):
                    what = "agent (no matching conversation; shell)"
                else:
                    what = ("agent " + pane["agent"]) if pane.get("agent") else " ".join(pane.get("command") or ["shell"])
                print("    %s  %s" % (pane.get("cwd", "~"), what))


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="rex-snapshot", description=__doc__.splitlines()[0])
    sub = parser.add_subparsers(dest="cmd", required=True)
    sub.add_parser("save", help="save the current sessions now")
    sub.add_parser("watch", help="save periodically and restore after a restart")
    p_restore = sub.add_parser("restore", help="relaunch programs in restored panes and rebuild missing sessions")
    p_restore.add_argument("file", nargs="?", type=Path, default=LAST)
    p_restore.add_argument("--dry-run", action="store_true", help="print the requests only")
    sub.add_parser("linger", help="keep Rex running when no one is logged in")
    p_import = sub.add_parser("import-tmux", help="rebuild a tmux-resurrect save as Rex sessions, once")
    p_import.add_argument("file", nargs="?", type=Path, default=TMUX_RESURRECT)
    p_import.add_argument("--dry-run", action="store_true", help="show what would be created")
    p_import.add_argument("--force", action="store_true", help="import a save that was imported before")
    p_show = sub.add_parser("show", help="summarize a snapshot")
    p_show.add_argument("file", nargs="?", type=Path, default=LAST)
    args = parser.parse_args(argv[1:])

    if args.cmd == "save":
        summarize(save())
    elif args.cmd == "watch":
        watch()
    elif args.cmd == "restore":
        snapshot = read_snapshot(args.file)
        if not snapshot:
            print("no snapshot at %s" % args.file, file=sys.stderr)
            return 1
        relaunch(snapshot, dry_run=args.dry_run)
        restore(snapshot, dry_run=args.dry_run)
    elif args.cmd == "linger":
        return 0 if ensure_linger() else 1
    elif args.cmd == "import-tmux":
        if not args.file.exists():
            print("no tmux-resurrect save at %s" % args.file, file=sys.stderr)
            return 1
        return import_tmux(args.file, dry_run=args.dry_run, force=args.force)
    elif args.cmd == "show":
        snapshot = read_snapshot(args.file)
        if not snapshot:
            print("no snapshot at %s" % args.file, file=sys.stderr)
            return 1
        summarize(snapshot)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
