#!/usr/bin/env bash
# Preview script for tmux-worktree-popup fzf picker.
# Usage: tmux-worktree-preview <branch> <worktree-data-file> [pr-cache-file]
# Worktree data file has tab-separated branch\tpath lines.

set -euo pipefail

branch="$1"
wtfile="$2"
pr_cache="${3:-}"

# Strip ANSI codes, status prefix, and trailing PR badge
branch=$(printf '%s' "$branch" | sed $'s/\033\[[0-9;]*m//g' | sed $'s/^[\uf023\uf059\uf06a\uf00c\uf021] //' | sed 's/^  //' | sed 's/   *#[0-9]*$//')

# ANSI helpers
bold=$'\033[1m'
dim=$'\033[2m'
reset=$'\033[0m'
red=$'\033[31m'
green=$'\033[32m'
yellow=$'\033[33m'
blue=$'\033[34m'
magenta=$'\033[35m'
cyan=$'\033[36m'
gray=$'\033[90m'

path=$(awk -F'\t' -v b="$branch" '$1 == b { print $2; exit }' "$wtfile")

if [[ -z "$path" ]]; then
    echo "${dim}No worktree for this branch${reset}"
    exit 0
fi

# --- Header: branch name + age ---
last_commit_ts=$(git -C "$path" log -1 --format='%ct' 2>/dev/null || echo "")
age=""
if [[ -n "$last_commit_ts" ]]; then
    now=$(date +%s)
    delta=$(( now - last_commit_ts ))
    if (( delta < 3600 )); then
        age="$(( delta / 60 ))m ago"
    elif (( delta < 86400 )); then
        age="$(( delta / 3600 ))h ago"
    elif (( delta < 604800 )); then
        age="$(( delta / 86400 ))d ago"
    elif (( delta < 2592000 )); then
        age="$(( delta / 604800 ))w ago"
    else
        age="$(( delta / 2592000 ))mo ago"
    fi
    # Color: gray < 1 week, yellow < 3 weeks, red >= 3 weeks
    if (( delta >= 1814400 )); then
        age="${red}${age}${reset}"
    elif (( delta >= 604800 )); then
        age="${yellow}${age}${reset}"
    else
        age="${gray}${age}${reset}"
    fi
fi

# Pad branch and age to fill the line
cols=${FZF_PREVIEW_COLUMNS:-80}
branch_display="${bold}${branch}${reset}"
printf "  %s%*s\n" "$branch_display" $(( cols - ${#branch} - 4 )) "$age"
printf "  ${gray}%*s${reset}\n" $(( cols - 4 )) "" | tr ' ' '─'

# --- Claude status (if available) ---
status_file="$path/.claude/status.json"
if [[ -f "$status_file" ]]; then
    IFS=$'\t' read -r claude_status claude_ts < <(jq -r '[(.status // ""), (.timestamp // "")] | @tsv' "$status_file" 2>/dev/null) || true
    status_age=""
    if [[ -n "$claude_ts" ]]; then
        now=$(date +%s)
        sa=$(( now - claude_ts ))
        if (( sa < 60 )); then
            status_age="${sa}s"
        elif (( sa < 3600 )); then
            status_age="$(( sa / 60 ))m"
        elif (( sa < 86400 )); then
            status_age="$(( sa / 3600 ))h"
        else
            status_age="$(( sa / 86400 ))d"
        fi
    fi
    case "$claude_status" in
        working)
            echo "  ${blue}"$'\uf021'"${reset} ${bold}Claude working${reset} ${gray}${status_age}${reset}"
            ;;
        completed)
            echo "  ${green}"$'\uf00c'"${reset} ${bold}Claude done${reset} ${gray}${status_age}${reset}"
            ;;
        question)
            echo "  ${yellow}"$'\uf059'"${reset} ${bold}${yellow}Needs input${reset} ${gray}${status_age}${reset}"
            ;;
        permission)
            echo "  ${magenta}"$'\uf023'"${reset} ${bold}${magenta}Permission needed${reset} ${gray}${status_age}${reset}"
            ;;
        attention)
            echo "  ${yellow}"$'\uf06a'"${reset} ${bold}${yellow}Needs attention${reset} ${gray}${status_age}${reset}"
            ;;
    esac
fi

# --- PR status (if cache available) ---
if [[ -n "$pr_cache" && -f "$pr_cache" ]]; then
    pr_info=$(awk -F'\t' -v b="$branch" '$1 == b { print $2 "\t" $3 "\t" $4; exit }' "$pr_cache")
    if [[ -n "$pr_info" ]]; then
        IFS=$'\t' read -r pr_num pr_state pr_draft <<< "$pr_info"

        # State display with color
        local_state=""
        case "$pr_state" in
            OPEN)
                if [[ "$pr_draft" == "true" ]]; then
                    local_state="${gray}Draft${reset}"
                else
                    local_state="${green}Open${reset}"
                fi
                ;;
            MERGED) local_state="${magenta}Merged${reset}" ;;
            CLOSED) local_state="${red}Closed${reset}" ;;
        esac

        echo ""
        echo "  ${bold}PR #${pr_num}${reset} — ${local_state}"

        # For open (non-draft) PRs, fetch title + review + CI status
        if [[ "$pr_state" == "OPEN" && "$pr_draft" != "true" ]]; then
            pr_detail=$(gh pr view "$pr_num" --json title,reviewDecision,statusCheckRollup \
                --jq '[.title, .reviewDecision, ((.statusCheckRollup // []) | map(.conclusion) | if length == 0 then "PENDING" elif all(. == "SUCCESS") then "SUCCESS" elif any(. == "FAILURE") then "FAILURE" elif any(. == null) then "RUNNING" else "UNKNOWN" end)] | @tsv' 2>/dev/null) || pr_detail=""
            if [[ -n "$pr_detail" ]]; then
                IFS=$'\t' read -r pr_title pr_review pr_ci <<< "$pr_detail"

                if [[ -n "$pr_title" ]]; then
                    echo "  ${dim}${pr_title}${reset}"
                fi

                # Review + CI on one line
                review_badge="" ci_badge=""
                case "$pr_review" in
                    APPROVED)          review_badge="${green}✔ Approved${reset}" ;;
                    CHANGES_REQUESTED) review_badge="${red}✘ Changes requested${reset}" ;;
                    REVIEW_REQUIRED)   review_badge="${yellow}○ Review needed${reset}" ;;
                    "")                review_badge="${gray}○ No reviews${reset}" ;;
                esac
                case "$pr_ci" in
                    SUCCESS) ci_badge="${green}✔ CI pass${reset}" ;;
                    FAILURE) ci_badge="${red}✘ CI fail${reset}" ;;
                    RUNNING) ci_badge="${blue}⟳ CI running${reset}" ;;
                    PENDING) ci_badge="${gray}○ CI pending${reset}" ;;
                esac
                if [[ -n "$review_badge" || -n "$ci_badge" ]]; then
                    echo "  ${review_badge}    ${ci_badge}"
                fi
            fi
        fi
    fi
fi

# --- Last commit message ---
commit_msg=$(git -C "$path" log -1 --format='%s' 2>/dev/null || echo "")
if [[ -n "$commit_msg" ]]; then
    echo ""
    echo "  ${commit_msg}"
fi

# --- Status line: dirty state + divergence ---
echo ""
printf "  ${gray}%*s${reset}\n" $(( cols - 4 )) "" | tr ' ' '╌'
echo ""

# Working tree state
staged=$(git -C "$path" diff --cached --numstat 2>/dev/null | wc -l | tr -d ' ')
modified=$(git -C "$path" diff --numstat 2>/dev/null | wc -l | tr -d ' ')
untracked=$(git -C "$path" ls-files --others --exclude-standard 2>/dev/null | wc -l | tr -d ' ')

dirty_parts=()
if (( staged > 0 )); then dirty_parts+=("${staged} staged"); fi
if (( modified > 0 )); then dirty_parts+=("${modified} modified"); fi
if (( untracked > 0 )); then dirty_parts+=("${untracked} untracked"); fi

if (( ${#dirty_parts[@]} > 0 )); then
    dirty="${yellow}●${reset} $(IFS=', '; echo "${dirty_parts[*]}")"
else
    dirty="${green}✔${reset} ${dim}Clean${reset}"
fi

# Divergence from main/master
if git -C "$path" rev-parse --verify --quiet refs/heads/main >/dev/null 2>&1; then
    main_branch=main
else
    main_branch=master
fi
ahead=0
behind=0
if git -C "$path" rev-parse --verify --quiet "refs/heads/${main_branch}" >/dev/null 2>&1; then
    read -r behind ahead < <(git -C "$path" rev-list --left-right --count "${main_branch}...HEAD" 2>/dev/null || echo "0 0")
fi

divergence=""
if (( ahead > 0 && behind > 0 )); then
    divergence="${cyan}↑${ahead}${reset} ${red}↓${behind} ${main_branch}${reset}"
    if (( behind > 20 )); then
        divergence="${divergence} ${red}⚠${reset}"
    fi
elif (( ahead > 0 )); then
    divergence="${cyan}↑${ahead} ahead of ${main_branch}${reset}"
elif (( behind > 0 )); then
    divergence="${red}↓${behind} behind ${main_branch}${reset}"
    if (( behind > 20 )); then
        divergence="${divergence} ${red}⚠${reset}"
    fi
fi

# Print status + divergence on one line
if [[ -n "$divergence" ]]; then
    echo "  ${dirty}    ${divergence}"
else
    echo "  ${dirty}"
fi

# --- Recent commits ---
echo ""
printf "  ${gray}%*s${reset}\n" $(( cols - 4 )) "" | tr ' ' '╌'
echo ""
echo "  ${gray}Recent commits${reset}"

git -C "$path" log --oneline --no-decorate -15 2>/dev/null | while IFS= read -r line; do
    echo "  ${line}"
done

# --- Footer: path ---
echo ""
short_path="${path/#$HOME/~}"
echo "  ${gray}${short_path}${reset}"
